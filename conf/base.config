process {
    cache         = 'lenient'
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_load       { cpus = 4;  memory = { 32.GB  * task.attempt } }
    withLabel: process_qc         { cpus = 2;  memory = { 32.GB  * task.attempt } }
    withLabel: process_highmem    { cpus = 16; memory = { 256.GB * task.attempt } }
    withLabel: process_insitutype { cpus = 8;  memory = { 64.GB  * task.attempt } }
    withLabel: process_diag       { cpus = 8;  memory = { 64.GB  * task.attempt } }
    withLabel: process_spatial    { cpus = 8;  memory = { 48.GB  * task.attempt } }
    withLabel: process_cci        { cpus = 16; memory = { 128.GB * task.attempt } }
    withLabel: process_smide      { cpus = 2;  memory = { 32.GB  * task.attempt } }
    withLabel: process_light      { cpus = 2;  memory = { 16.GB  * task.attempt } }

    // A solo object is one sample, not the full merged cohort -- don't reserve process_highmem for it.
    withName: 'SOLO_(INTEGRATE|CLUSTER)' { cpus = 8; memory = { 96.GB * task.attempt } }
}
