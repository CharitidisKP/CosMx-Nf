// One machine, local executor, every task inside the Apptainer image. The image, R libraries,
// Python and bind mounts are params, set per machine in conf/site.yaml (see conf/site.example.yaml).
params {
    tmpdir = "/tmp/${System.getenv('USER')}-nf/Rtmp"
}

process {
    executor       = 'local'
    container      = params.sif
    resourceLimits = [ cpus: 16, memory: 160.GB ]
}

executor {
    queueSize = 6
    cpus      = 48
    memory    = '160 GB'
}

apptainer {
    enabled      = true
    autoMounts   = true
    // Unset params add no --env, so the image's own defaults apply
    runOptions   = ( ['--cleanenv'] +
                     [ RETICULATE_PYTHON: params.container_python,
                       R_LIBS_USER      : params.r_libs_user,
                       R_LIBS           : params.r_libs,
                       TMPDIR           : params.tmpdir,
                       VROOM_TEMP_PATH  : params.tmpdir ]
                         .findAll { _k, v -> v }.collect { k, v -> "--env ${k}=${v}" } +
                     ( params.bind ? params.bind.split(',').collect { b -> "-B ${b}" } : [] ) ).join(' ')
    envWhitelist = 'OMP_NUM_THREADS,OPENBLAS_NUM_THREADS,MKL_NUM_THREADS,BLIS_NUM_THREADS'
}
