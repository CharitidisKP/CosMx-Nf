# Nextflow
.nextflow*
work/
Runs/
tmp/

# Pipeline output trees (historical ones live outside git)
results/
results_*/
Archive/
Manual_run_Results/

# Scratch and working docs kept out of the repo
Other/

# R session state
.RData
.Rhistory
.Rproj.user/

# Knit artifacts and editor scratch
*_files/
figure/
*.html
# The report's table script, included on every page
!report/_tables.html
*.pdf
*.bak_*
notebooks/*.txt
notebooks/*.log
notebooks/.vdoc.*
notebooks/.vscode/

# Logs and OS noise
omnipathr-log/
.DS_Store

# Reference profile matrices and NicheNet model files, staged per machine
assets/profiles/
assets/nichenet/

# Working notes for the next session
handoff.md

# Site settings and the real sample sheets, kept out of git
conf/site.yaml
assets/private/
data/

# Built Apptainer images
*.sif

# A run's curated labels, when the app runs against a results mirror in this folder
/labels/
